# edit: Claude (Fable 5.1), 2026-09-19 23:46 +0400 — the 24 h life runs genome/G4.genome (PREREG §12); the skeleton's life (G4-skeleton.genome, 22:29 → the restart) is kept at run-skeleton-20260919/.
[Unit]
Description=creature — the whole small creature (G4 walking skeleton)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/dev/genome
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStart=/usr/bin/python3 -m creature.body --root /data/dev/genome/run --genome /data/dev/genome/genome/G4.genome
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
