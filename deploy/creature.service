# edit: Claude (Sonnet 5, G4 builder A), 2026-09-19 22:52 +0400 — A5 (docs/G4-PREREG.md §2.10). A user unit;
# install.sh copies and daemon-reloads only — Claude enables/starts, after the gates (PREREG §7).
# edit: Claude (Fable 5.1), 2026-09-19 23:46 +0400 — the 24 h life runs genome/G4.genome (PREREG §12); the skeleton's life (G4-skeleton.genome, 22:29 → the restart) is kept at run-skeleton-20260919/.
[Unit]
Description=creature — the whole small creature (G4 walking skeleton)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/dev/genome
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStart=/usr/bin/python3 -m creature.body --root /data/dev/genome/run --genome /data/dev/genome/genome/G4.genome
# edit: Claude (Fable 5.1), 2026-09-23 04:15 +0400 — PREREG §2.6: a MIND crash exits 3 and must NOT be restarted (alpha4-pre-1: one
# int64 crash at its 2nd sleep became 10 identical crashes in 2 min under Restart=on-failure — #230's loop in this template).
# A sense crash never exits the process (it restarts in-thread); only a mind crash exits 3.
Restart=on-failure
# edit: Claude (Opus 5.5), 2026-09-26 18:54 +0400 — SOLUTIONS #240: the body exits 4 (CLOSED_EXIT) when its root carries STOPPED-AT;
# a closed life is never resumed by a restart, so 4 is never restarted either (3 stays the mind's crash).
RestartPreventExitStatus=3 4
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
