# edit: Claude (Sonnet 5, BRAIN builder B), 2026-09-28 20:44 +0400 — BRAIN-IN-BODY §5 (docs/brain/body/INTERFACE-BRAIN-ORGAN.md):
# a TEMPLATED user unit, one instance per brain-in-body life, %i = the life's name = its root under
# /data/dev/genome-lives/ (OUTSIDE every worktree). WorkingDirectory is the life's OWN detached checkout
# (tools/lives/launch_brain.sh's `git worktree add --detach … <commit>`) — one code version per life, so a
# closed tape replays under its own commit, never a worktree that moves at every landing (creature-g5@'s own
# law, kept whole here). GENOME comes from unit.env (written by launch_brain.sh). No --folder, no
# --plant-after: this life's world is WORLD_SCENE, not the maker's.
# install.sh copies and daemon-reloads only — the seat enables/starts an instance after the gates.
[Unit]
Description=creature-brain %i — a brain-in-body life (root /data/dev/genome-lives/%i)
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/data/dev/genome-lives/%i/code
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=PYTHONUNBUFFERED=1
# edit: Claude (Fable 5.1, the seat), 2026-09-28 21:10 +0400 — BODY_ARGS: the life's own extra body arguments, from unit.env (empty for a
# lean life). The full organism needs the folder door's directory (his pictures live in /data/dev/genome/world, outside every
# checkout) and the plant's canvas, as creature-g5@ passes them. Unbraced, so systemd splits it into words; empty adds none.
Environment=BODY_ARGS=
EnvironmentFile=/data/dev/genome-lives/%i/unit.env
ExecStart=/usr/bin/python3 -m creature.body --root /data/dev/genome-lives/%i --genome ${GENOME} $BODY_ARGS
# edit: Claude (Sonnet 5, BRAIN builder B), 2026-09-28 20:44 +0400 — PREREG §2.6 (creature-g5@'s own law, kept
# whole): a MIND crash exits 3 and must NOT be restarted; a sense crash never exits the process.
Restart=on-failure
# SOLUTIONS #240: the body exits 4 (CLOSED_EXIT) when its root carries STOPPED-AT; a closed life is never
# resumed by a restart, so 4 is never restarted either (3 stays the mind's crash).
RestartPreventExitStatus=3 4
RestartSec=5
TimeoutStopSec=120

[Install]
WantedBy=default.target
