# edit: Claude (Fable 5.1), 2026-09-21 20:56 +0400 — the 8 h SEAM LIVES (docs/G5-SEAM-LIFE-PLAN.md §0): a TEMPLATED user unit, one instance per
# life, %i = the life's name = its root under /data/dev/genome-lives/ (OUTSIDE every worktree). WorkingDirectory is the life's
# OWN detached checkout `/data/dev/genome-lives/<name>/code` (`git worktree add --detach … <commit>`) — one code version per life; a
# closed tape replays under its own commit; never the integration worktree, which moves at every landing (corrected 2026-09-21 21:03 +0400 on the
# advisor's read). --folder /data/dev/genome/world: the folder door resolves `world/` against the CODE tree, his pictures live only there. --plant-after 5000: the plant at hour ≈ 6.9 of an 8 h life (window 3), 5 showings over the next hour.
# install.sh copies and daemon-reloads only — Claude enables/starts an instance after the gates (PREREG §7's law).
# edit: Claude (Fable 5.1), 2026-09-21 23:22 +0400 — THE LADDER (his 23:20 word): the genome comes from the life's own unit.env (GENOME=<path>, written by the launch
# script and kept in the root as the life's record), so one template serves the top rung (G5.genome) and every ladder rung (genome/ladder/L*.genome).
# edit: Claude (Fable 5.1), 2026-09-22 18:24 +0400 — THE ONE LIFE (docs/organs/NEXT-LIFE-PLAN-2026-09-22.md §6): the plant's canvas comes from unit.env's PLANT_AFTER (15000 for a 24 h life = hour ≈ 21; the 8 h seam lives keep 5000 by the default above).
[Unit]
Description=creature-g5 %i — an 8 h seam life of the G5 creature (root /data/dev/genome-lives/%i)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/data/dev/genome-lives/%i/code
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=PLANT_AFTER=5000
# unit.env's PLANT_AFTER (written by tools/lives/launch.sh) overrides the 5000 default above — systemd takes no trailing comments, so this line stands alone
EnvironmentFile=/data/dev/genome-lives/%i/unit.env
ExecStart=/usr/bin/python3 -m creature.body --root /data/dev/genome-lives/%i --genome ${GENOME} --plant-after ${PLANT_AFTER} --folder /data/dev/genome/world
Restart=on-failure
RestartSec=5
# edit: Claude (Fable 5.1), 2026-09-22 22:47 +0400 — 30 s was thin for the ONE life: stop() joins up to eight senses for 5 s each (the hands' jail among them),
# then close() lands the in-flight think and saves a NMAX-sized matrix (8000² × 8 B = 512 MB before compression); a SIGKILL here loses the tail think
# and the stop event (the 24 h verdict waits for it). The six 8 h closes took < 1 s after the joins at NMAX 2000; the pre-flight measures the ONE life's.
TimeoutStopSec=120

[Install]
WantedBy=default.target
