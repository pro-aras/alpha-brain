# SEAT-LINE sha256 1d00a35f…): every 5 minutes from brain-long-5's launch until the copy is DONE (then disable
# it) — bl3-origin-fallback.timer's form, renamed.
# Install: ~/.config/systemd/user/bl5-origin-fallback.timer
[Unit]
Description=bl5 origin fallback copy, every 5 min
[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
OnActiveSec=1min
[Install]
WantedBy=timers.target
